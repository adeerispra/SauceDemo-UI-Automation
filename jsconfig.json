{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": false
  },
  "include": [
    "playwright.config.js",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
